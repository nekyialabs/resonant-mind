{
  "name": "resonant-mind",
  "version": "4.1.3",
  "private": true,
  "description": "A Postgres-backed cognitive substrate for persistent AI memory, identity, dreams, drives, and relational continuity",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run tests/postgres-v4.integration.test.ts",
    "test:postgres:merge": "vitest run tests/merge-lossless.integration.test.ts",
    "test:registry": "vitest run tests/registry.test.ts",
    "test:migration": "vitest run tests/migration",
    "scan:release": "node scripts/scan-release.mjs",
    "check:merge-damage": "node scripts/check-merge-damage.mjs",
    "repair:merge-vectors": "node scripts/repair-merge-vectors.mjs",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "migrate:v32": "node scripts/v32-to-v4/cli.mjs",
    "verify:v32-fixtures": "node scripts/verify-v32-fixtures.mjs",
    "test:migration:postgres": "vitest run tests/migration/postgres-source.integration.test.mjs tests/migration/postgres-source-session.integration.test.mjs tests/migration/target-fresh.integration.test.mjs tests/migration/cli-flow.integration.test.mjs tests/migration/postgres-spec.integration.test.mjs tests/migration/cli-postgres.integration.test.mjs tests/migration/e2e-postgres.integration.test.mjs tests/migration/e2e-postgres-rich.integration.test.mjs tests/migration/v4-checks.integration.test.mjs",
    "verify": "npm run verify:v32-fixtures && npm run typecheck && npm test && npm run scan:release && npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@google/genai": "2.11.0",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/pg": "8.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "@protobufjs/utf8": "1.1.2",
    "undici": "7.30.1"
  }
}
